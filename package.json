{
  "name": "@kitsuneflora/ui",
  "version": "0.1.0-alpha.1",
  "description": "暖狐毛风格的 Vue 3 UI 组件库",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "KitsuneFlora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KitsuneFlora/ui.git"
  },
  "homepage": "https://github.com/KitsuneFlora/ui#readme",
  "bugs": {
    "url": "https://github.com/KitsuneFlora/ui/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./tokens.css": "./dist/tokens.css",
    "./reset.css": "./dist/reset.css",
    "./preset.css": "./dist/preset.css",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run tokens:generate && vite build && node scripts/copy-css-exports.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "playground": "npm run build && npm --prefix playground run dev"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "reka-ui": "^2.10.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-links": "^10.5.7",
    "@storybook/vue3": "^10.5.7",
    "@storybook/vue3-vite": "^10.5.7",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "storybook": "^10.5.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.30",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": ">=24"
  }
}
