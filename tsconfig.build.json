{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": false,
    "noEmit": false
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "tests",
    "stories",
    "playground",
    "dist",
    "node_modules"
  ]
}
